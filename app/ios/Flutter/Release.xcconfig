#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// AIGammon: statically link the Rust engine staticlib into Runner.
// CI (ios.yml) stages libaigammon_engine.a at $(PROJECT_DIR)/Frameworks/ (i.e.
// app/ios/Frameworks/). -force_load pulls in ALL of the shim's #[no_mangle]
// exports (wildbg_new_with_path, best_move, probabilities, cube_info,
// wildbg_free) so the linker's dead-code stripping cannot drop symbols that are
// only referenced at runtime via dart:ffi DynamicLibrary.process() lookups.
// See native/README.md "iOS" for the -lc++ troubleshooting note.
// Preserve global symbols for DynamicLibrary.process() in the main executable.
// -force_load alone does not keep runtime-only FFI exports with Xcode 27.
OTHER_LDFLAGS = $(inherited) -force_load $(PROJECT_DIR)/Frameworks/libaigammon_engine.a -force_load $(PROJECT_DIR)/Frameworks/libbuddy_gnubg.a -lc++ -Wl,-dead_strip -Wl,-export_dynamic

// Dart FFI resolves these C symbols from the app executable at runtime. The
// default `all` strip style removes them from Xcode archives even when
// `-export_dynamic` is present; keep global exports and strip only local symbols.
STRIP_STYLE = non-global
