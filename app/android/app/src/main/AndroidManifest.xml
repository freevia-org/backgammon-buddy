<!-- The `tools` namespace is load-bearing, not decorative: the
     `android.hardware.camera.any` entry below is the one line in this file that
     has to BEAT a plugin's contribution rather than merely add to it, and
     `tools:replace` is the only thing that does. See that entry. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required by every networked mode: Play Online (Firestore) and Play
         Nearby (the LAN WebSocket server/client plus the UDP discovery beacon).

         It must live in THIS manifest, not only in src/debug and src/profile:
         those variants are merged into debug/profile builds alone, so a RELEASE
         APK built without this line has no INTERNET permission at all — every
         socket fails and both remote modes are dead on a shipped build while
         working perfectly in development. No plugin in this app contributes the
         permission through manifest merging, so nothing else supplies it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- No advertising features. Remove the identifier permission contributed
         by Analytics so optional diagnostics cannot access the advertising ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- Measurement dependencies also contribute Privacy Sandbox capabilities.
         Neither advertising IDs nor attribution is used by this app. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove"/>
    <!-- The v1 camera is optional and used only for nearby QR joining. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Physical-board Buddy is parked for v2. Remove record's transitive mic
         permission as well as our former declaration; QR needs no audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"
        tools:node="remove"/>
    <!-- Optional hardware must not narrow the supported device set. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- THE ONE ENTRY THAT HAS TO OVERRIDE A PLUGIN, AND WHY.

         Buddy Mode brought `camera` in, and its Android implementation
         (`camera_android_camerax`) contributes this to the merge:

             <uses-feature android:name="android.hardware.camera.any" />

         with no `android:required` — which DEFAULTS TO TRUE. That is a
         different feature name from the three above, so none of them cancels
         it, and the merged release manifest of this app would require a camera:
         Play filters the listing, and every camera-less device loses install
         eligibility for an app whose nearby QR camera is optional. Nearby QR scanning treats the camera as optional.

         `android:required="false"` on its own is NOT enough. The manifest
         merger combines two `uses-feature` nodes of the same name by OR-ing
         their `required` flags, so a plain false loses to the plugin's implicit
         true and nothing is logged. `tools:replace="android:required"` is what
         makes this node's value win instead of merge.

         **The true verification is the MERGED manifest, which no test in this
         repository can see.** `android_manifest_test.dart` pins the source line
         including the `tools:replace`, because that attribute is the whole
         mechanism and dropping it would look like a tidy-up. What the pin
         cannot do is prove the merger honoured it: that is `aapt dump badging`
         on the APK `android.yml` builds (expect
         `uses-feature-not-required:'android.hardware.camera.any'`, and NO bare
         `uses-feature:'android.hardware.camera.any'`), or the Play Console's
         device catalogue on the uploaded artifact. It is item 4 of the
         on-device protocol. -->
    <uses-feature android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required"/>
    <!-- Also merged in from `camera_android_camerax`, and left alone
         deliberately:

             <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
               android:maxSdkVersion="28" />

         The plugin declares it for its own picture/video capture-to-file paths,
         which Buddy Mode never calls — it takes an image STREAM and converts
         frames in an isolate; nothing in this app writes a camera file. It is
         capped at API 28, so on every device this app's `minSdk` targets that
         is not the newest platform it is simply absent, and on the ones where
         it does apply it is a normal runtime permission nothing ever requests.

         It appears in the merged manifest regardless and there is no way to
         remove it that is worth the cost: `tools:node="remove"` would delete a
         declaration the plugin may start relying on in a future version, and
         the failure would be at runtime inside somebody else's code. Recorded
         here so that "why does the release manifest ask for external storage?"
         has an answer that does not require reading the pub cache. -->

    <!-- Deliberately NO usesCleartextTraffic and no network_security_config, even
         though Play Nearby dials a plain `ws://` LAN address and API 28+ blocks
         cleartext by default.

         That default does not reach this code. Android enforces it through
         NetworkSecurityPolicy, which java.net / OkHttp / WebView consult — and
         `dart:io` does not: WebSocket.connect and HttpClient are implemented in the
         VM over raw POSIX sockets. So a cleartext exception here would buy nothing,
         while a global usesCleartextTraffic="true" would weaken the app's posture
         for the native layers that DO honour the policy.

         Recorded because "Android is blocking cleartext" is the obvious first guess
         when a LAN join fails, and it is the wrong one — the shipped join hang was
         a dropped handshake frame in Dart (see SocketTransport.host). Revisit only
         if a plugin or platform channel, rather than dart:io, ever needs http://. -->

    <application
        android:label="Backgammon Buddy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Optional telemetry stays off before Dart reads the persisted choice. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false"/>
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false"/>
        <meta-data android:name="firebase_performance_collection_enabled" android:value="false"/>
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false"/>
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Android 11+ package visibility for the user's installed speech engine. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
