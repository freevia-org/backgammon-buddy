# Release provenance hashes must survive Windows/Linux checkout differences.
# Preserve upstream license typography, including original trailing spaces.
app/assets/licenses/native-dependencies.txt text eol=lf whitespace=-blank-at-eol
app/assets/licenses/wildbg-training-CC0.txt text eol=lf
native/licenses/upstream/*.txt text eol=lf
native/licenses/*.json text eol=lf
app/assets/licenses/*.tar.gz binary
app/assets/licenses/okhttp-publicsuffix-* text eol=lf whitespace=-blank-at-eol
# Mobile notices retain exact upstream bytes, including mixed CRLF/LF sources.
native/licenses/mobile/texts/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
native/licenses/mobile/*.json text eol=lf
app/assets/licenses/android-native-notices.txt -text whitespace=-blank-at-eol
app/assets/licenses/apple-native-notices.txt -text whitespace=-blank-at-eol
# GNUbg asset checksums include the XML's exact upstream bytes. Preserve these
# across Windows/Linux checkouts; vendored source keeps upstream whitespace.
app/assets/gnubg/* -text whitespace=-blank-at-eol,-blank-at-eof
app/assets/licenses/GPL-3.0.txt -text whitespace=-blank-at-eol,-blank-at-eof
app/assets/licenses/expat-COPYING.txt -text whitespace=-blank-at-eol,-blank-at-eof
native/gnubg/upstream/** text=auto eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
native/gnubg/vendor/** text=auto eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
